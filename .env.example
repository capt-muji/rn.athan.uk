# Environment variable catalog - copy to .env for local builds.
# Expo CLI auto-loads .env from the project root; shell env overrides it.
# Real secret values are never committed (keep .env untracked).

# Environment: local (launch-relative mock data) | preview | prod (real API)
EXPO_PUBLIC_ENV=local

# londonprayertimes.com API key - placeholder only; the real value lives
# outside the repo and is passed inline to production builds
EXPO_PUBLIC_API_KEY=key

# App Store numeric id + the two store ids for the update popup. The committed values are
# placeholders: the build scripts inject the published ids from outside the repository, and a
# clone with no environment builds and updates under its own.
EXPO_PUBLIC_IOS_APP_ID=6740474033
EXPO_PUBLIC_ANDROID_PACKAGE=com.example.athan
EXPO_PUBLIC_IOS_BUNDLE_ID=com.example.athan

# Store ids, read by app.config.ts at prebuild time. Nothing here is the published value: the
# owner's build scripts export the real ones, a stranger's build exports its own, and a build with
# no environment writes the neutral defaults into the native project.
EXPO_APP_ID=com.example.athan
EXPO_BUNDLE_ID=com.example.athan
EXPO_APP_GROUP=group.com.example.athan
EXPO_EAS_PROJECT_ID=

# Feature flags (see shared/flags.ts) - absence or 0 = disabled, only the
# exact string 1 enables
EXPO_PUBLIC_IOS_WIDGETS=1
EXPO_PUBLIC_ANDROID_WIDGETS=1
