+/// Caches the view built for one entry render.
+///
+/// SwiftUI evaluates `body` whenever the view is invalidated, and every
+/// evaluation here re-runs the JS layout, rebuilds the whole native view tree
+/// and re-converts every node's props through the dynamic props machinery.
+/// That is milliseconds for a handful of views and seconds for a few dozen, so
+/// a moderately sized widget exhausts the extension's CPU budget (50% over
+/// 180s) and iOS terminates it mid-render. WidgetKit then has no render to
+/// show and falls back to its "Please adopt containerBackground API"
+/// diagnostic, which makes a pure performance failure look like a missing
+/// modifier.
+///
+/// The render is a pure function of the layout, the entry's props and the
+/// environment, so repeat evaluations can reuse the result. The key covers all
+/// three, and the short lifetime bounds how long a timeline pushed seconds ago
+/// could be served from an older render.
+private final class WidgetsRenderCache {
+  static let shared = WidgetsRenderCache()
+
+  private struct CachedRender {
+    let view: WidgetsDynamicView
+    let storedAt: Date
+  }
+
+  private let lock = NSLock()
+  private var renders: [String: CachedRender] = [:]
+  /// Enough for the entries WidgetKit renders in one pass; cleared wholesale
+  /// rather than evicted one by one, because the cost of a miss is one render.
+  private let capacity = 16
+  private let lifetime: TimeInterval = 5
+
+  func view(forKey key: String, build: () -> WidgetsDynamicView) -> WidgetsDynamicView {
+    lock.lock()
+    defer { lock.unlock() }
+
+    if let cached = renders[key], Date().timeIntervalSince(cached.storedAt) < lifetime {
+      return cached.view
+    }
+
+    let built = build()
+    if renders.count >= capacity {
+      renders.removeAll()
+    }
+    renders[key] = CachedRender(view: built, storedAt: Date())
+    return built
+  }
+}
