{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "subagent_depth": 2
  },
  "mcp": {
    "expo": {
      "type": "remote",
      "url": "https://mcp.expo.dev/mcp",
      "enabled": true
    },
    "mobile-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@mobilenext/mobile-mcp@latest"],
      "environment": { "MOBILEMCP_DISABLE_TELEMETRY": "1" },
      "enabled": true
    },
    "maestro": {
      "type": "local",
      "command": ["/Users/muji/.maestro/bin/maestro", "mcp"],
      "environment": { "MAESTRO_CLI_NO_ANALYTICS": "1" },
      "enabled": true
    },
    "xcodebuildmcp": {
      "type": "local",
      "command": ["npx", "-y", "xcodebuildmcp@latest", "mcp"],
      "enabled": true
    },
    "agent-device": {
      "type": "local",
      "command": ["npx", "-y", "agent-device@latest", "mcp"],
      "enabled": true
    }
  }
}
