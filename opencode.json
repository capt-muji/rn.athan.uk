{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "subagent_depth": 2
  },
  "mcp": {
    "mobile-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@mobilenext/mobile-mcp@latest"],
      "environment": {
        "MOBILEMCP_DISABLE_TELEMETRY": "1"
      },
      "enabled": false
    },
    "maestro": {
      "type": "local",
      "command": ["{env:HOME}/.maestro/bin/maestro", "mcp"],
      "environment": {
        "MAESTRO_CLI_NO_ANALYTICS": "1"
      },
      "enabled": false
    },
    "agent-device": {
      "type": "local",
      "command": ["npx", "-y", "agent-device@latest", "mcp"],
      "enabled": false
    },
    "xcodebuildmcp": {
      "type": "local",
      "command": ["npx", "-y", "xcodebuildmcp@latest", "mcp"],
      "enabled": false
    },
    "expo": {
      "type": "remote",
      "url": "https://mcp.expo.dev/mcp",
      "enabled": false
    },
    "servers": {
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"],
        "disabled": true,
        "codemode": false
      },
      "itsaplan": {
        "type": "remote",
        "url": "http://localhost:3000/mcp",
        "headers": {
          "x-api-key": "{env:ITSAPLAN_API_KEY}"
        }
      }
    }
  }
}
