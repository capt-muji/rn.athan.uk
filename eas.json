{
  "cli": {
    "version": ">= 12.6.1",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENV": "preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENV": "prod"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6740474033"
      },
      "android": {
        "track": "alpha",
        "serviceAccountKeyPath": "$HOME/.config/athan/athan-486118-66c0837dd5c5.json"
      }
    }
  }
}
