{
  "expo": {
    "name": "Athan",
    "slug": "athan",
    "version": "1.18.9",
    "orientation": "portrait",
    "scheme": "athan",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icons/config/icon-ios.png",
    "backgroundColor": "#2c1c77",
    "ios": {
      "icon": "./assets/icons/config/icon-ios.png",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.mugtaba.athan",
      "infoPlist": {
        "CFBundleDisplayName": "Athan",
        "NSUserNotificationsUsageDescription": "Receive prayer time notifications"
      },
      "backgroundColor": "#2c1c77"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/config/icon-android-adaptive.png",
        "backgroundColor": "#2c1c77"
      },
      "package": "com.mugtaba.athan",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "USE_EXACT_ALARM",
        "SCHEDULE_EXACT_ALARM",
        "WAKE_LOCK",
        "ACCESS_NOTIFICATION_POLICY"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "parentTheme": "Default",
            "enforceNavigationBarContrast": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2c1c77",
          "image": "./assets/icons/config/icon-splash.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/Roboto-Regular.ttf", "./assets/fonts/Roboto-Medium.ttf"]
        }
      ],
      [
