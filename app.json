      ],
      "./plugins/removeUnusedAndroidPermissions",
      "./plugins/gradleJvmMemory",
      "expo-asset",
      "expo-background-task",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "PrayerWidget",
              "displayName": "Next Prayer (Light)",
