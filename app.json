{
  "expo": {
    "name": "Athan",
    "slug": "athan",
    "version": "2.0.919",
    "orientation": "portrait",
    "scheme": "athan",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icons/config/icon-ios.png",
    "backgroundColor": "#2c1c77",
    "ios": {
      "icon": "./assets/icons/config/icon-ios.png",
      "supportsTablet": true,
      "requireFullScreen": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.mugtaba.athan",
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "CFBundleDisplayName": "Athan",
        "CFBundleLocalizations": ["en", "ar", "ms", "so", "hi", "th"],
        "NSLocationWhenInUseUsageDescription": "Your location is used to work out which way Makkah is from where you are. It never leaves your phone.",
        "NSUserNotificationsUsageDescription": "Receive prayer time notifications"
      },
      "backgroundColor": "#2c1c77"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/config/icon-android-adaptive.png",
        "backgroundColor": "#2c1c77"
      },
      "package": "com.mugtaba.athan",
      "versionCode": 1000000,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "USE_EXACT_ALARM",
        "SCHEDULE_EXACT_ALARM",
        "WAKE_LOCK",
        "ACCESS_NOTIFICATION_POLICY"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# Glance composes widgets through WorkManager; R8 strips OverwritingInputMerger's constructor without these keeps (verified on the 3T: the widget stays on its loading layout forever and logcat shows WM-InputMerger NoSuchMethodException)\n-keep class androidx.work.** { *; }\n-keep class androidx.glance.** { *; }\n-dontwarn androidx.work.**\n-dontwarn androidx.glance.**\n# Expo 58 serves haptics and application through Modules v2: the host builds module classes from their no-arg constructors by reflection, the kolibri runtime reads its JNI bridge fields (NativeObject.nativePointer) from C++ alone, and the JSI dispatch reaches each module's @JS functions and argument types without a Java call graph for R8 to follow. io.github.expo ships no consumer rules for any of it, so R8 strips all of it (verified on the 3T: haptics never reach the vibrator; constructors alone crash at launch with NoSuchFieldError nativePointer; without the module packages the dispatch dies silently with VibrationType stripped)\n-keep class io.github.expo.kolibri.** { *; }\n-keep class io.github.expo.modules.v2.** { *; }\n-keep class expo.modules.haptics.** { *; }\n-keep class expo.modules.application.** { *; }\n-keep class expo.modules.ExpoModulesV2ModuleList { *; }"
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "parentTheme": "Default",
            "enforceNavigationBarContrast": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2c1c77",
          "image": "./assets/icons/config/icon-splash.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
