{
  "name": "athan",
  "version": "1.7.1",
  "type": "commonjs",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start -c",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "reset": "yarn clean && yarn install && yarn husky && yarn start",
    "clean": "rm -rf ios android node_modules yarn.lock .expo .vscode .husky && yarn cache clean && rm -rf /tmp/metro-*",
    "add": "echo 'Use: `npx expo install <package>` for Expo/RN packages, yarn add <package> for others'",
    "husky": "husky install && husky add .husky/pre-commit 'npx lint-staged && yarn validate'",
    "test": "jest",
    "test:debug": "DEBUG_TESTS=1 jest",
    "test:watch": "DEBUG_TESTS=1 jest --watch",
    "validate": "tsc --noEmit && biome check . && jest --silent",
    "format": "biome check --write .",
    "format:check": "biome check ."
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,mjs}": [
      "biome check --write",
      "jest --bail --findRelatedTests --passWithNoTests"
    ]
  },
  "dependencies": {
    "@expo/ui": "~57.0.14",
    "@gorhom/bottom-sheet": "5.2.14",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.15",
    "expo-audio": "~57.0.4",
    "expo-background-task": "~57.0.14",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.14",
    "expo-updates": "~57.0.19",
    "expo-widgets": "~57.0.15",
    "jotai": "2.20.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-edge-to-edge": "1.8.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "reanimated-color-picker": "5.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-modules-commonjs": "^7.29.0",
    "@babel/preset-typescript": "^7.29.0",
    "@biomejs/biome": "2.5.11",
    "@types/jest": "^30.0.0",
    "@types/node": "26.4.0",
    "@types/react": "~19.2.4",
    "husky": "8.0.3",
    "jest": "^30.4.2",
    "lint-staged": "15.5.2",
    "pino": "9.14.0",
    "pino-pretty": "13.1.3",
    "react-native-svg-transformer": "1.5.2",
    "typescript": "~7.0.2"
  }
}
