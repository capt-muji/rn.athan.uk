{
  "name": "athan",
  "version": "2.0.893",
  "type": "commonjs",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start -c",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "reset": "yarn clean && yarn install && yarn husky && yarn start",
    "clean": "rm -rf ios android node_modules yarn.lock .expo .vscode .husky/_ && yarn cache clean && rm -rf /tmp/metro-*",
    "add": "echo 'Use: `npx expo install <package>` for Expo/RN packages, yarn add <package> for others'",
    "prepare": "husky",
    "husky": "husky",
    "postinstall": "patch-package",
    "test": "jest",
    "test:debug": "DEBUG_TESTS=1 jest",
    "test:watch": "DEBUG_TESTS=1 jest --watch",
    "test:tz": "for tz in America/New_York Asia/Tokyo Pacific/Kiritimati Pacific/Pago_Pago; do echo \"TZ=$tz\"; TZ=$tz jest --silent || exit 1; done",
    "check:device": "e2e/scripts/device-checks.sh",
    "i18n:export": "I18N_BRIDGE=export npx jest shared/__tests__/i18nBridge.test.ts --watchman=false --selectProjects=unit",
    "i18n:import": "I18N_BRIDGE=import npx jest shared/__tests__/i18nBridge.test.ts --watchman=false --selectProjects=unit",
    "i18n:lock": "node scripts/catalog-lock.mjs",
    "validate": "tsc --noEmit && biome check . --error-on-warnings && jest --silent --coverage",
    "format": "biome check --write .",
    "format:check": "biome check ."
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,mjs}": [
      "biome check --write --no-errors-on-unmatched",
      "jest --bail --findRelatedTests --passWithNoTests"
    ]
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@expo/log-box": "~58.0.12",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/ui": "58.0.19",
    "@gorhom/bottom-sheet": "5.2.14",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "expo": "~58.0.12",
    "expo-asset": "~58.0.16",
    "expo-audio": "~58.0.9",
    "expo-background-task": "~58.0.11",
    "expo-build-properties": "~58.0.10",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.6",
    "expo-in-app-updates": "0.12.0",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-location": "~58.0.16",
    "expo-notifications": "~58.1.4",
    "expo-router": "~58.0.21",
    "expo-splash-screen": "~58.0.9",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-updates": "~58.0.17",
    "expo-widgets": "58.0.19",
    "jotai": "3.0.1",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-edge-to-edge": "1.8.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-pager-view": "9.0.7",
    "react-native-performance": "7.0.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "reanimated-color-picker": "5.1.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-modules-commonjs": "^7.29.0",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@babel/preset-typescript": "^7.29.0",
    "@biomejs/biome": "2.5.15",
    "@jest/create-cache-key-function": "30.5.1",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "expo-dev-client": "~58.0.13",
    "husky": "9.1.7",
    "jest": "^30.4.2",
    "jest-expo": "~58.0.11",
    "lint-staged": "17.6.0",
    "mp3-duration": "^1.1.0",
    "patch-package": "^8.0.1",
    "pino-pretty": "13.2.0",
    "postinstall-postinstall": "^2.1.0",
    "react-native-svg-transformer": "1.5.3",
    "test-renderer": "1.3.0",
    "typescript": "~7.0.2"
  }
}
